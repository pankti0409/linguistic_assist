ELEVENLABS_API_KEY=
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
VOICE_ID=                       # legacy single voice; prefer the two slots below
VOICE_ID_MALE=                  # ElevenLabs voice labelled gender=male
VOICE_ID_FEMALE=                # ElevenLabs voice labelled gender=female
VOICE_DEFAULT=female            # male | female; switch at runtime with PUT /voice
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=
TAVUS_PIPELINE_MODE=full        # full (mic off, relay-only persona) | echo
SIMULATE=0
MIC_DEVICE=                    # optional input name/index; macOS prefers built-in microphone
CAMERA_SOURCE=0                 # index, or a video file path when SIMULATE=1
LIP_ENABLED=1
LIP_HF_SPACE=marshal-yash/vsr_trlrs3vox2_base  # HF Space ID; set to use cloud lip reader
LIP_HF_BEAM_SIZE=20                            # beam search width 5..40
LIP_HF_TOKEN=                                  # optional HF token for private Spaces
ALLOWED_ORIGINS=                 # extra browser origins allowed on /ws (comma-separated)
DEBUG_PREVIEW=0                 # 1 enables GET /camera/preview.mjpg
ACCESS_TOKEN=                   # optional shared secret for every route except /health
TAVUS_CALLBACK_URL=             # optional public URL for Tavus guardrail webhooks
AVATAR_AUDIO_ECHO=1             # 0 = start the ladder at text echo
